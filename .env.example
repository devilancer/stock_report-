# LLM 연동 (선택) — 복사해서 .env 로 사용
# cp .env.example .env

# ── 방법 1: Google Gemini (가장 간단) ─────────────────────────
# GEMINI_API_KEY 만 설정하면 엔드포인트·기본 모델(gemini-3.8-flash)이 자동 구성됩니다.
# https://aistudio.google.com/apikey 에서 발급 (AIza... 로 시작)
GEMINI_API_KEY=AIza...

# ── 방법 2: OpenAI 호환 엔드포인트 ────────────────────────────
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# ── 공통 (선택) ───────────────────────────────────────────────
# LLM_API_KEY 가 AIza 로 시작해도 Gemini 로 자동 감지합니다.
# LLM_BASE_URL / LLM_MODEL 을 명시하면 위 자동 감지 기본값보다 우선합니다.
LLM_TIMEOUT=45
